# ======================================================
# ENVIRONMENT VARIABLES TEMPLATE
# ======================================================
# Copy this file to .env and update with your actual values

# ======================================================
# APPLICATION SETTINGS
# ======================================================
APP_NAME="TecWorld Academy"
APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost:3000
APP_TIMEZONE=Africa/Accra

# ======================================================
# DATABASE CONFIGURATION
# ======================================================
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=techworld_db
DB_USERNAME=root
DB_PASSWORD=
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_unicode_ci

# ======================================================
# MAIL CONFIGURATION (PHPMailer)
# ======================================================
MAIL_MAILER=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-app-password
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=info@tecworldacademy.edu
MAIL_FROM_NAME="TecWorld Academy"

# ======================================================
# AUTHENTICATION & SESSION
# ======================================================
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=false
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
PASSWORD_HASH_ALGO=PASSWORD_BCRYPT
PASSWORD_COST=10

# ======================================================
# FILE UPLOAD SETTINGS
# ======================================================
MAX_FILE_SIZE=10485760
ALLOWED_FILE_TYPES=pdf,doc,docx,ppt,pptx,jpg,jpeg,png,gif,zip
UPLOAD_PATH=upload/
ASSIGNMENT_UPLOAD_PATH=upload/assignments/
COURSE_UPLOAD_PATH=upload/courses/
PROFILE_UPLOAD_PATH=upload/profiles/

# ======================================================
# PAGINATION & LIMITS
# ======================================================
ITEMS_PER_PAGE=10
COURSES_PER_PAGE=12
STUDENTS_PER_PAGE=15
ASSIGNMENTS_PER_PAGE=20

# ======================================================
# API KEYS & EXTERNAL SERVICES
# ======================================================
GOOGLE_ANALYTICS_ID=
GOOGLE_MAPS_API_KEY=
FACEBOOK_APP_ID=
TWITTER_API_KEY=
PAYMENT_GATEWAY_KEY=
PAYMENT_GATEWAY_SECRET=

# ======================================================
# CLOUDINARY (for media storage)
# ======================================================
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ======================================================
# SECURITY SETTINGS
# ======================================================
SECURITY_SALT=your-random-security-salt-here
JWT_SECRET=your-jwt-secret-key-here
CSRF_TOKEN_NAME=csrf_token
ENCRYPTION_KEY=your-encryption-key-here
RATE_LIMIT_ENABLED=true
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_TIME=900

# ======================================================
# LOGGING & DEBUGGING
# ======================================================
LOG_LEVEL=debug
LOG_PATH=logs/
ERROR_LOG=logs/error.log
ACCESS_LOG=logs/access.log
AUDIT_LOG=logs/audit.log

# ======================================================
# CACHE SETTINGS
# ======================================================
CACHE_ENABLED=true
CACHE_DRIVER=file
CACHE_PREFIX=techworld_
CACHE_TTL=3600

# ======================================================
# LMS SETTINGS
# ======================================================
COURSE_ENROLLMENT_AUTO_APPROVE=false
ASSIGNMENT_MAX_ATTEMPTS=3
QUIZ_TIME_LIMIT=3600
CERTIFICATE_ENABLED=true
CERTIFICATE_PATH=assets/cert/

# ======================================================
# NOTIFICATION SETTINGS
# ======================================================
NOTIFICATION_ENABLED=true
EMAIL_NOTIFICATIONS=true
SMS_NOTIFICATIONS=false
PUSH_NOTIFICATIONS=false
SMS_PROVIDER=
SMS_API_KEY=
SMS_SENDER_ID=TecWorld

# ======================================================
# PAYMENT SETTINGS
# ======================================================
PAYMENT_ENABLED=true
PAYMENT_CURRENCY=GHS
PAYMENT_MODE=test
STRIPE_PUBLIC_KEY=
STRIPE_SECRET_KEY=
PAYPAL_CLIENT_ID=
PAYPAL_SECRET=
PAYSTACK_PUBLIC_KEY=
PAYSTACK_SECRET_KEY=

# ======================================================
# SOCIAL MEDIA LINKS
# ======================================================
SOCIAL_FACEBOOK=https://facebook.com/tecworldacademy
SOCIAL_TWITTER=https://twitter.com/tecworldacademy
SOCIAL_INSTAGRAM=https://instagram.com/tecworldacademy
SOCIAL_LINKEDIN=https://linkedin.com/company/tecworldacademy
SOCIAL_YOUTUBE=https://youtube.com/tecworldacademy

# ======================================================
# CONTACT INFORMATION
# ======================================================
CONTACT_PHONE=+233 55 123 4567
CONTACT_EMAIL=info@tecworldacademy.edu
CONTACT_ADDRESS="Accra, Ghana"
SUPPORT_EMAIL=support@tecworldacademy.edu

# ======================================================
# BACKUP SETTINGS
# ======================================================
BACKUP_ENABLED=true
BACKUP_PATH=backup/
BACKUP_RETENTION_DAYS=30
AUTO_BACKUP=false

# ======================================================
# MAINTENANCE MODE
# ======================================================
MAINTENANCE_MODE=false
MAINTENANCE_MESSAGE="We are currently performing scheduled maintenance. Please check back soon."

# ======================================================
# ANALYTICS & REPORTING
# ======================================================
ANALYTICS_ENABLED=true
REPORT_EXPORT_FORMATS=pdf,csv,excel
MAX_EXPORT_RECORDS=5000

# ======================================================
# THIRD-PARTY INTEGRATIONS
# ======================================================
ZOOM_API_KEY=
ZOOM_API_SECRET=
GOOGLE_CLASSROOM_ENABLED=false
MICROSOFT_TEAMS_ENABLED=false

# ======================================================
# SOCIAL SIGN-IN (see docs/oauth_signin_setup.md)
# ======================================================
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:8000/authenication/oauth/callback.php
MICROSOFT_OAUTH_CLIENT_ID=
MICROSOFT_OAUTH_CLIENT_SECRET=
MICROSOFT_OAUTH_TENANT=common
MICROSOFT_OAUTH_REDIRECT_URI=http://localhost:8000/authenication/oauth/callback.php
YAHOO_OAUTH_CLIENT_ID=
YAHOO_OAUTH_CLIENT_SECRET=
YAHOO_OAUTH_REDIRECT_URI=http://localhost:8000/authenication/oauth/callback.php

# ======================================================
# LOCALE & LANGUAGE
# ======================================================
DEFAULT_LOCALE=en
AVAILABLE_LOCALES=en,es,fr
DATE_FORMAT=Y-m-d
TIME_FORMAT=H:i:s
DATETIME_FORMAT=Y-m-d H:i:s

# ======================================================
# ADMIN SETTINGS
# ======================================================
ADMIN_EMAIL=admin@tecworldacademy.edu
SUPER_ADMIN_ROLE=super_admin
ENABLE_USER_REGISTRATION=true
EMAIL_VERIFICATION_REQUIRED=true
